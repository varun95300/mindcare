rules_version = '2';

// DEMO MODE: anyone with the app can read and write. This is intentional so
// two devices can be tested quickly. Before real use, restrict every
// collection to the signed-in patient and their psychologist.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

